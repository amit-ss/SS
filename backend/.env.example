# CampusGPT Backend Environment Configuration

# Django Core
SECRET_KEY=campusgpt-lpu-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6IYeJa1-E4ewyh4Rdw0Wh2hB7a6tkkxI8HPeZ7mgDlacw
GEMINI_MODEL=gemini-1.5-flash

# AI provider: auto (local Ollama -> Ollama Cloud -> Gemini) | ollama_local | ollama_cloud | gemini
AI_PROVIDER=auto

# Ollama LOCAL - install from https://ollama.com, then run:  ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Ollama CLOUD - create a key at https://ollama.com/settings/keys
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# Database Configuration
# Set USE_MYSQL=True when your MySQL server is running, or False for SQLite
USE_MYSQL=False
MYSQL_DATABASE=ss_database
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# CORS
CORS_ALLOW_ALL_ORIGINS=True
